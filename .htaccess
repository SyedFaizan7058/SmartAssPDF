# ==============================================================================
# SmartAssPDF — Production Apache / LiteSpeed Configuration (.htaccess)
# Automatic Frontend Routing, Security Shield, 301 Redirects, HTTPS & Caching
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ----------------------------------------------------------------------------
  # 1. Security Shield: Block access to backend, .git, and config files
  # ----------------------------------------------------------------------------
  RewriteRule ^\.git - [F,L]
  RewriteRule ^backend - [F,L]
  RewriteRule ^render\.yaml - [F,L]
  RewriteRule ^Dockerfile - [F,L]
  RewriteRule ^netlify\.toml - [F,L]
  RewriteRule ^README\.md - [F,L]

  # ----------------------------------------------------------------------------
  # 2. Force HTTPS & Canonical Non-WWW Domain
  # ----------------------------------------------------------------------------
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://smartasspdf.com/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.smartasspdf\.com$ [NC]
  RewriteRule ^(.*)$ https://smartasspdf.com/$1 [R=301,L]

  # ----------------------------------------------------------------------------
  # 3. 301 Redirects: Old Root Tool URLs -> Modern URLs
  # ----------------------------------------------------------------------------
  RewriteRule ^pdf-to-word\.html$ /tools/pdf-to-word.html [R=301,L]
  RewriteRule ^word-to-pdf\.html$ /tools/word-to-pdf.html [R=301,L]
  RewriteRule ^pdf-to-excel\.html$ /tools/pdf-to-excel.html [R=301,L]
  RewriteRule ^excel-to-pdf\.html$ /tools/excel-to-pdf.html [R=301,L]
  RewriteRule ^pdf-to-ppt\.html$ /tools/pdf-to-ppt.html [R=301,L]
  RewriteRule ^html-to-pdf\.html$ /tools/html-to-pdf.html [R=301,L]
  RewriteRule ^pdf-to-jpg\.html$ /tools/pdf-to-jpg.html [R=301,L]
  RewriteRule ^jpg-to-pdf\.html$ /tools/image-to-pdf.html [R=301,L]
  RewriteRule ^image-to-pdf\.html$ /tools/image-to-pdf.html [R=301,L]
  RewriteRule ^image-to-webp\.html$ /tools/image-to-webp.html [R=301,L]
  RewriteRule ^compress-pdf\.html$ /tools/compress-pdf.html [R=301,L]
  RewriteRule ^merge-pdf\.html$ /tools/merge-pdf.html [R=301,L]
  RewriteRule ^split-pdf\.html$ /tools/split-pdf.html [R=301,L]
  RewriteRule ^rotate-pdf\.html$ /tools/rotate-pdf.html [R=301,L]
  RewriteRule ^add-page-numbers\.html$ /tools/add-page-numbers.html [R=301,L]
  RewriteRule ^protect-pdf\.html$ /tools/protect-pdf.html [R=301,L]
  RewriteRule ^unlock-pdf\.html$ /tools/unlock-pdf.html [R=301,L]
  RewriteRule ^add-watermark\.html$ /tools/add-watermark.html [R=301,L]
  RewriteRule ^extract-pages\.html$ /tools/extract-pages.html [R=301,L]
  RewriteRule ^remove-pages\.html$ /tools/remove-pages.html [R=301,L]
  RewriteRule ^ocr-pdf\.html$ /tools/ocr-pdf.html [R=301,L]
  RewriteRule ^repair-pdf\.html$ /tools/repair-pdf.html [R=301,L]
  RewriteRule ^compare-pdf\.html$ /tools/compare-pdf.html [R=301,L]
  RewriteRule ^sanitize-pdf\.html$ /tools/sanitize-pdf.html [R=301,L]
  RewriteRule ^sign-pdf\.html$ /tools/sign-pdf.html [R=301,L]

  # Legacy Pages
  RewriteCond %{REQUEST_URI} ^/FAQ\.html$
  RewriteRule ^FAQ\.html$ /faq.html [R=301,L]
  RewriteRule ^blog\.html$ /blog/index.html [R=301,L]
  RewriteRule ^tools\.html$ /#tools [R=301,NE,L]
  RewriteRule ^continue-tools\.html$ /#tools [R=301,NE,L]
  RewriteRule ^features\.html$ /#features [R=301,NE,L]
  RewriteRule ^security\.html$ /privacy.html [R=301,L]
  RewriteRule ^dpa\.html$ /privacy.html [R=301,L]

  # ----------------------------------------------------------------------------
  # 4. Transparent Routing: Serve all requests from frontend/ directory
  # ----------------------------------------------------------------------------
  # Route Homepage
  RewriteRule ^$ frontend/index.html [L]

  # Route direct file or folder requests from frontend/
  RewriteCond %{REQUEST_URI} !^/frontend/
  RewriteCond %{DOCUMENT_ROOT}/frontend/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/frontend/$1 -d
  RewriteRule ^(.*)$ frontend/$1 [L]

  # Fallback for paths inside frontend
  RewriteCond %{REQUEST_URI} !^/frontend/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ frontend/$1 [L]

</IfModule>

# ------------------------------------------------------------------------------
# 5. Custom Error Document
# ------------------------------------------------------------------------------
ErrorDocument 404 /frontend/404.html

# ------------------------------------------------------------------------------
# 6. Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------------------------
# 7. GZIP Compression
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 8. Browser Caching
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>